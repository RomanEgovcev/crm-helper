{
  "manifest_version": 3,
  "name": "CRM Helper - Автоконтроль таймеров",
  "version": "2.0",
  "description": "Автоматический контроль времени на линии, дозвона в CRM и отображение номера звонящего",
  "permissions": ["storage", "activeTab", "alarms", "tabs"],
  "host_permissions": ["https://api.telegram.org/*", "https://num.voxlink.ru/*", "https://victory-crm.ru/*", "https://ect-russia.ru/*", "https://script.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.yandex.ru/*", "*://music.yandex.com/*"],
      "js": ["music.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CRM Helper"
  }
}
